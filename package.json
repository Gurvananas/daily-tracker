{
  "name": "daily-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Suivi quotidien de métriques personnelles — PWA et appli Android (Health Connect), prête pour 2027.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "build:www": "node scripts/build-www.mjs",
    "android:sync": "npm run build:www && npx cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
